import { Theme } from "theme.slint";

// Themed text: always uses the theme font and colour.
export component T inherits Text {
    font-family: Theme.font;
    color: Theme.text;
    font-size: 13px;
}

export component Dim inherits Text {
    font-family: Theme.font;
    color: Theme.text-dim;
    font-size: 12px;
}

export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
}

export component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 36px;
    border-radius: Theme.radius-small;
    background: !enabled ? Theme.surface-alt
        : primary ? (ta.pressed ? Theme.accent.darker(0.25) : ta.has-hover ? Theme.accent.brighter(0.2) : Theme.accent)
        : danger ? (ta.has-hover ? Theme.bad : Theme.bad.with-alpha(0.75))
        : (ta.pressed ? Theme.border.darker(0.2) : ta.has-hover ? Theme.border : Theme.surface-alt);
    animate background { duration: 120ms; }
    opacity: enabled ? 1.0 : 0.5;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: center;
        T {
            text: root.text;
            font-weight: 600;
            vertical-alignment: center;
            color: (root.primary || root.danger) ? Theme.on-accent : Theme.text;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Toggle inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled(bool);
    width: 44px;
    height: 24px;
    border-radius: self.height / 2;
    background: checked ? Theme.accent : Theme.border;
    animate background { duration: 140ms; }
    Rectangle {
        y: 3px;
        x: root.checked ? root.width - self.width - 3px : 3px;
        width: 18px;
        height: 18px;
        border-radius: self.width / 2;
        background: Theme.on-accent;
        animate x { duration: 140ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

export component Slide inherits Rectangle {
    in-out property <float> value: 0.5;
    callback changed-by-user(float);
    height: 26px;
    function update(x: length) {
        root.value = Math.max(0.0, Math.min(1.0, (x - 10px) / (root.width - 20px)));
        root.changed-by-user(root.value);
    }
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 6px;
        border-radius: self.height / 2;
        background: Theme.border;
        Rectangle {
            x: 0px;
            width: parent.width * root.value;
            border-radius: self.height / 2;
            background: Theme.accent-gradient;
        }
    }
    Rectangle {
        x: (root.width - self.width) * root.value;
        y: (root.height - self.height) / 2;
        width: 20px;
        height: 20px;
        border-radius: self.width / 2;
        background: Theme.text;
        border-width: 3px;
        border-color: Theme.accent;
    }
    TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down { root.update(self.mouse-x); }
        }
        moved => { root.update(self.mouse-x); }
    }
}

export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> mono: false;
    callback accepted(string);
    callback edited(string);
    height: 36px;
    border-radius: Theme.radius-small;
    background: Theme.surface-alt;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    animate border-color { duration: 120ms; }
    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        single-line: true;
        vertical-alignment: center;
        text <=> root.text;
        font-family: Theme.font;
        font-size: 13px;
        color: Theme.text;
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.on-accent;
        accepted => { root.accepted(self.text); }
        edited => { root.edited(self.text); }
    }
    if root.text == "" && !input.has-focus: Dim {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        vertical-alignment: center;
        text: root.placeholder;
    }
}

export component SegControl inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current: 0;
    callback selected(int);
    height: 34px;
    border-radius: Theme.radius-small;
    background: Theme.surface-alt;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for opt[i] in root.options: Rectangle {
            border-radius: Theme.radius-small - 2px;
            background: i == root.current ? Theme.accent : transparent;
            animate background { duration: 140ms; }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                T {
                    text: opt;
                    font-weight: 600;
                    vertical-alignment: center;
                    color: i == root.current ? Theme.on-accent : Theme.text-dim;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.current = i;
                    root.selected(i);
                }
            }
        }
    }
}

export component Dot inherits Rectangle {
    in property <bool> on: false;
    width: 10px;
    height: 10px;
    border-radius: self.width / 2;
    background: on ? Theme.good : Theme.text-dim.with-alpha(0.5);
}

export component RarityChip inherits Rectangle {
    in property <int> rarity: 0;
    in property <string> label;
    height: 22px;
    border-radius: self.height / 2;
    background: Theme.rarity-brush(rarity).transparentize(0.82);
    border-width: 1px;
    border-color: Theme.rarity-color(rarity).transparentize(0.35);
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        T {
            text: root.label == "" ? Theme.rarity-name(root.rarity) : root.label;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
            color: Theme.rarity-color(root.rarity);
        }
    }
}

// Scrollable area with a slim themed scrollbar thumb.
export component ScrollBox inherits Rectangle {
    in-out property <length> content-height <=> fl.content-height;
    in-out property <length> content-y <=> fl.content-y;
    fl := Flickable {
        @children
    }
    if fl.content-height > root.height + 1px: Rectangle {
        x: root.width - 7px;
        width: 4px;
        border-radius: self.width / 2;
        background: Theme.border;
        height: Math.max(32px, root.height * root.height / fl.content-height);
        y: -fl.content-y / Math.max(1px, fl.content-height - root.height) * (root.height - self.height);
    }
}

export component Icon inherits Rectangle {
    in property <int> kind: 0;
    in property <color> tint: Theme.text;
    width: 20px;
    height: 20px;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.tint;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: root.kind == 0 ? "M3 3h8v8H3z M13 3h8v5h-8z M13 10h8v11h-8z M3 13h8v8H3z"
            : root.kind == 1 ? "M5 21V11 M12 21V3 M19 21V15"
            : root.kind == 2 ? "M12 3a9 9 0 1 0 0.01 0z M12 7v5l3 2"
            : root.kind == 3 ? "M9 11a3 3 0 1 0 0.01 0z M3 20c0-3.5 2.7-6 6-6s6 2.5 6 6 M17 8a2.5 2.5 0 1 1 0.01 0 M17 14c2.5 0 4.5 2 4.5 5"
            : "M4 7h16 M4 17h16 M9 4v6 M15 14v6";
    }
}

// Count display: eases between values and "pops" on every increment.
export component BigCounter inherits Rectangle {
    in property <int> value: 0;
    in property <length> size: 80px;
    in property <brush> tint: Theme.text;
    property <float> shown: value;
    property <float> pop: 0;
    animate shown { duration: 500ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    animate pop { duration: 260ms; easing: ease-out; }
    changed value => {
        root.pop = 1.0;
        pop-timer.running = true;
    }
    pop-timer := Timer {
        interval: 70ms;
        running: false;
        triggered => {
            root.pop = 0.0;
            self.running = false;
        }
    }
    T {
        width: 100%;
        height: 100%;
        horizontal-alignment: left;
        vertical-alignment: center;
        text: "\{Math.round(root.shown)}";
        font-size: root.size + root.size * 0.12 * root.pop;
        font-weight: 800;
        color: root.tint;
    }
}

// Pulsing coloured rings around a card while a Legendary / Mythic was just tagged.
export component GlowFrame inherits Rectangle {
    in property <int> rarity: -1;
    property <bool> active: rarity >= 4 && Theme.glow > 0.01;
    property <float> pulse: active ? (0.55 + 0.45 * Math.sin((animation-tick() / 700ms) * 360deg)) * Theme.glow : 0.0;
    background: transparent;
    for k in 3: Rectangle {
        x: -2px - k * 3px;
        y: -2px - k * 3px;
        width: root.width + 4px + k * 6px;
        height: root.height + 4px + k * 6px;
        border-radius: Theme.radius + 2px + k * 3px;
        border-width: 2px;
        border-color: Theme.rarity-color(root.rarity).transparentize(0.25 + k * 0.25);
        opacity: root.pulse;
    }
}

// Half-circle luck gauge. value 0 (very unlucky) .. 1 (very lucky); animated.
export component LuckGauge inherits Rectangle {
    in property <float> value: 0.5;
    property <float> v: Math.max(0.004, Math.min(0.996, value));
    animate v { duration: 900ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    property <float> ex: 100 - 80 * Math.cos(180deg * v);
    property <float> ey: 100 - 80 * Math.sin(180deg * v);
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 200;
        viewbox-height: 112;
        stroke: Theme.border;
        stroke-width: 14px;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M20 100 A80 80 0 0 1 180 100";
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 200;
        viewbox-height: 112;
        stroke: Theme.luck-color(root.v);
        stroke-width: 14px;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M20 100 A80 80 0 0 1 \{root.ex} \{root.ey}";
    }
    @children
}

// Luck bar: red -> green track with a marker at the percentile.
export component LuckBar inherits Rectangle {
    in property <float> value: 0.5;
    height: 8px;
    border-radius: self.height / 2;
    background: Theme.luck-gradient;
    opacity: 0.55;
    Rectangle {
        x: (root.width - self.width) * root.value;
        y: -3px;
        width: 4px;
        height: 14px;
        border-radius: self.width / 2;
        background: Theme.text;
    }
}
