import { Theme } from "theme.slint";
import { Backend, PlayerRow } from "backend.slint";
import { T, Dim, Card, Btn, Field, Dot, ScrollBox } from "widgets.slint";

component RosterLine inherits Rectangle {
    in property <PlayerRow> rw;
    height: 54px;
    border-radius: Theme.radius-small;
    background: rw.is-me ? Theme.surface-alt : transparent;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        Rectangle {
            width: 28px;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: self.width / 2;
                background: rw.color;
                T {
                    text: rw.initial;
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-weight: 800;
                    color: Theme.bg;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 8px;
                T { text: rw.name; font-weight: 700; overflow: elide; }
                if rw.is-host: Dim { text: "HOST"; color: Theme.warn; font-weight: 700; font-size: 10px; vertical-alignment: center; }
                if rw.is-me: Dim { text: "YOU"; font-size: 10px; font-weight: 700; vertical-alignment: center; }
            }
            Dim {
                text: (rw.connected ? "connected" : "disconnected") + "  ·  " + (rw.detecting ? "detecting" : "viewer");
                font-size: 11px;
            }
        }
        Rectangle {
            width: 10px;
            Dot { on: rw.connected; }
        }
        T {
            width: 56px;
            text: "\{rw.chests}";
            font-size: 22px;
            font-weight: 800;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        if Backend.i-am-host && !rw.is-me: Rectangle {
            width: 60px;
            Btn {
                y: (parent.height - self.height) / 2;
                height: 30px;
                width: 60px;
                text: "Kick";
                danger: true;
                clicked => { Backend.kick(rw.id); }
            }
        }
    }
}

export component PartyPage inherits Rectangle {
    ScrollBox {
        VerticalLayout {
            padding: 28px;
            spacing: 18px;
            HorizontalLayout {
                VerticalLayout {
                    T { text: "Party"; font-size: 26px; font-weight: 800; }
                    Dim { text: "Peer-to-peer. No server, no port forwarding. Everyone's chests add up."; }
                }
                Rectangle { }
                Dim { text: Backend.link-text; vertical-alignment: center; }
            }

            if !Backend.in-party: HorizontalLayout {
                spacing: 18px;
                Card {
                    height: 220px;
                    VerticalLayout {
                        padding: 24px;
                        spacing: 12px;
                        T { text: "Create a party"; font-size: 18px; font-weight: 800; }
                        Dim { text: "You become the host and get a code to share with your friends."; wrap: word-wrap; }
                        Rectangle { }
                        Btn { text: "Create party"; primary: true; clicked => { Backend.create-party(); } }
                    }
                }
                Card {
                    height: 220px;
                    VerticalLayout {
                        padding: 24px;
                        spacing: 12px;
                        T { text: "Join a party"; font-size: 18px; font-weight: 800; }
                        Dim { text: "Paste the code your host sent you."; }
                        Field {
                            text <=> Backend.join-input;
                            placeholder: "LL-xxxx-xxxx-...";
                            accepted(t) => { Backend.join-party(t); }
                        }
                        Rectangle { }
                        HorizontalLayout {
                            spacing: 10px;
                            Btn { text: "Paste"; clicked => { Backend.paste-join(); } }
                            Btn { text: "Join party"; primary: true; clicked => { Backend.join-party(Backend.join-input); } }
                        }
                    }
                }
            }

            if Backend.in-party: Card {
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    alignment: start;
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            Dim { text: Backend.i-am-host ? "YOUR PARTY CODE" : "PARTY CODE"; font-weight: 700; letter-spacing: 2px; }
                            T { text: Backend.party-code; font-size: 18px; font-weight: 700; color: Theme.accent; overflow: elide; }
                        }
                        Btn { text: "Copy code"; primary: true; clicked => { Backend.copy-text(Backend.party-code); } }
                        Btn { text: "Leave"; danger: true; clicked => { Backend.leave-party(); } }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    HorizontalLayout {
                        Dim { text: "ROSTER"; font-weight: 700; letter-spacing: 2px; }
                        Rectangle { }
                        Dim { text: "party total"; vertical-alignment: center; }
                        T { text: " \{Backend.party-chests}"; font-size: 20px; font-weight: 800; color: Theme.accent; }
                    }
                    for p in Backend.roster: RosterLine { rw: p; }
                }
            }
            if Backend.net-notice != "": Rectangle {
                height: 40px;
                border-radius: Theme.radius-small;
                background: Theme.warn.transparentize(0.85);
                T {
                    x: 14px;
                    width: parent.width - 28px;
                    height: parent.height;
                    vertical-alignment: center;
                    text: Backend.net-notice;
                    color: Theme.warn;
                    overflow: elide;
                }
            }
            Dim {
                text: "Anyone with the code can join, so share it only with people you trust. The host can kick members, and if the host leaves the next member takes over.";
                wrap: word-wrap;
            }
        }
    }
}
